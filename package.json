{
  "name": "pi-taskforce",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "pi-extension",
    "tasks",
    "todo",
    "subagents",
    "orchestration",
    "ask",
    "human-in-the-loop"
  ],
  "description": "A pi extension for TODO lists as plain Markdown files, subagents, and asking the user or the parent agent",
  "pi": {
    "extensions": ["./extensions/index.ts"]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jandrikus/pi-taskforce.git"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "@types/node": "^22.10.0",
    "typebox": "1.3.27",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
